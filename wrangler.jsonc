{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hue-live-sports",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "hue-live-sports.tuler.dev", "custom_domain": true }],
  // The settings page (web/) is built first and served as static assets; these paths go to the Worker.
  "build": { "command": "bun run build:web" },
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhook/*", "/users/*", "/leagues/*"]
  },
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "Games" },
      { "name": "FEEDER", "class_name": "Feeder" },
      { "name": "USER", "class_name": "User" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Games", "Feeder", "User"] }]
  // Secrets (`wrangler secret put`, or .dev.vars locally):
  // WEBHOOK_SECRET, HUE_CLIENT_ID, HUE_CLIENT_SECRET, ADMIN_TOKEN
}
