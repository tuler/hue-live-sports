{
  "name": "hue-live-sports",
  "version": "0.1.0",
  "description": "Flash Philips Hue lights on live sports events (touchdowns, goals, wins)",
  "type": "module",
  "bin": {
    "hue-live-sports": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "compile": "bun build src/cli.ts --compile --outfile dist/hue-live-sports",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
