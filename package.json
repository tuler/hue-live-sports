{
  "name": "hue-live-sports",
  "version": "0.1.0",
  "description": "Flash Philips Hue lights on live sports events (touchdowns, goals, wins)",
  "type": "module",
  "bin": {
    "hue-live-sports": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "compile": "bun build src/cli.ts --compile --outfile dist/hue-live-sports",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
