# Bridge address: `bun start discover`
HUE_BRIDGE_IP=192.168.1.10
# App key: `bun start pair` (press the bridge's link button first)
HUE_APP_KEY=
# Optional: verify the bridge certificate instead of trusting the LAN.
# HUE_CA_FILE=./hue-root-ca.pem
# HUE_BRIDGE_ID=001788fffe000000
# Hue Remote API, to reach the bridge from outside the LAN (`--remote`).
# Register an app at developers.meethue.com, then run `bun start remote-auth`.
# HUE_CLIENT_ID=
# HUE_CLIENT_SECRET=
# HUE_TOKEN_FILE=.hue-tokens.json
# Signing secret for the webhook receiver, if enabled in config.json.
# WEBHOOK_SECRET=
